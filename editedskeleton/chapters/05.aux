\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Weight on the L2-difficult grammar \(G_1\) in the long run, as a function of various choices of L2-difficulty \(d\) and proportion of L2 learners \(\mitsigma \) (actual, not expected, proportion recorded at the end of simulation). The thick dashed curve gives the critical threshold (\ref {eq:bifurcation-threshold}) predicted by the deterministic model. Solid curves are contour lines. For simulation parameters, see Table \ref {tbl:bifu}.\relax }}{25}{figure.caption.19}\protected@file@percent }
\newlabel{fig:bifu}{{8}{25}{Weight on the L2-difficult grammar \(G_1\) in the long run, as a function of various choices of L2-difficulty \(d\) and proportion of L2 learners \(\sigma \) (actual, not expected, proportion recorded at the end of simulation). The thick dashed curve gives the critical threshold (\ref {eq:bifurcation-threshold}) predicted by the deterministic model. Solid curves are contour lines. For simulation parameters, see Table \ref {tbl:bifu}.\relax }{figure.caption.19}{}}
