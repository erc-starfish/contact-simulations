\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Two grammars, \(G_1\) and \(G_2\), generate languages \(L_1\) and \(L_2\), represented here as intersecting sets. The shaded areas are the sets \(L_1 \setminus L_2\) and \(L_2 \setminus L_1\); their sizes represent the probabilities that strings from these sets are produced, \(a_1\) and \(a_2\) (referred to as the advantages of \(G_1\) and \(G_2\), respectively).\relax }}{4}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:venn}{{1}{4}{Two grammars, \(G_1\) and \(G_2\), generate languages \(L_1\) and \(L_2\), represented here as intersecting sets. The shaded areas are the sets \(L_1 \setminus L_2\) and \(L_2 \setminus L_1\); their sizes represent the probabilities that strings from these sets are produced, \(a_1\) and \(a_2\) (referred to as the advantages of \(G_1\) and \(G_2\), respectively).\relax }{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Learning algorithm for L1 learner \parencite {BushMosteller1955,Yang2002}. The new values of $W_1$ and $W_2$ are $W_1' = W_1 + \mitDelta W_1$ and $W_2' = W_2 + \mitDelta W_2$. A positive $\mitDelta W_1$ (resp. $\mitDelta W_2$) rewards $G_1$ (resp. $G_2$), while a negative value punishes it.\relax }}{5}{table.caption.5}\protected@file@percent }
\newlabel{tbl-BM}{{1}{5}{Learning algorithm for L1 learner \parencite {BushMosteller1955,Yang2002}. The new values of $W_1$ and $W_2$ are $W_1' = W_1 + \Delta W_1$ and $W_2' = W_2 + \Delta W_2$. A positive $\Delta W_1$ (resp. $\Delta W_2$) rewards $G_1$ (resp. $G_2$), while a negative value punishes it.\relax }{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Learning algorithm for L2 learner \parencite {Kauhanen2022}. The new values of $W_1$ and $W_2$ are $W_1' = W_1 + \mitDelta W_1$ and $W_2' = W_2 + \mitDelta W_2$.\relax }}{6}{table.caption.6}\protected@file@percent }
\newlabel{tbl-BM2}{{2}{6}{Learning algorithm for L2 learner \parencite {Kauhanen2022}. The new values of $W_1$ and $W_2$ are $W_1' = W_1 + \Delta W_1$ and $W_2' = W_2 + \Delta W_2$.\relax }{table.caption.6}{}}
\newlabel{eq:definition-of-d}{{1}{6}{Responsive features in language acquisition}{equation.1.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three simulated learners, each in the same learning environment characterized by penalty probabilities \(c_1 = 0.05\) and \(c_2 = 0.4\) but with different learning rates: \(\mitgamma = 0.01\), \(\mitgamma = 0.05\) and \(\mitgamma = 0.1\). Each learner additionally is subject to an L2-difficulty of \(d = 0.05\). With these choices, the expected value of \(W_1\) at stationarity is \(0.8\) (the thick yellow curve gives the evolution of the expected value). With the parameters chosen, and with each learner starting from \(W_1(0) = 0.1\), the stationary distribution is reached after about the first \(10\mitgamma ^{-1}\) learning iterations. The weight \(W_2 = 1 - W_1\) is not shown.\relax }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:trajectories}{{2}{7}{Three simulated learners, each in the same learning environment characterized by penalty probabilities \(c_1 = 0.05\) and \(c_2 = 0.4\) but with different learning rates: \(\gamma = 0.01\), \(\gamma = 0.05\) and \(\gamma = 0.1\). Each learner additionally is subject to an L2-difficulty of \(d = 0.05\). With these choices, the expected value of \(W_1\) at stationarity is \(0.8\) (the thick yellow curve gives the evolution of the expected value). With the parameters chosen, and with each learner starting from \(W_1(0) = 0.1\), the stationary distribution is reached after about the first \(10\gamma ^{-1}\) learning iterations. The weight \(W_2 = 1 - W_1\) is not shown.\relax }{figure.caption.7}{}}
\newlabel{eq:EP}{{2}{8}{Responsive features in language acquisition}{equation.1.2.2}{}}
\newlabel{eq:VarP}{{3}{8}{Responsive features in language acquisition}{equation.1.2.3}{}}
